      "item": [
        {
          "name": "1. Listar visitantes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/visitantes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "visitantes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Criar visitante",
