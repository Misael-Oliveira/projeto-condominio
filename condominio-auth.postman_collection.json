                  "  pm.expect(corpo).to.not.include('\"token\"');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Quem sou eu - /me logado (esperado 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Só funciona depois do login (cookie guardado pelo Postman)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Formato { acao, message, dados }', () => {",
                  "  pm.expect(r.acao).to.eql('Ler');",
                  "  pm.expect(r.dados.email).to.eql(pm.collectionVariables.get('emailTeste'));",
                  "  pm.expect(r.dados.status).to.eql('ativo');",
                  "});",
                  "pm.test('Não devolve senha nem token', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('password');",
                  "  pm.expect(pm.response.text()).to.not.include('token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Sair (esperado 200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-out"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sair da conta. O Better Auth exige o cabeçalho Origin nos POSTs quando há cookie; já está incluído em todas as requisições POST desta coleção."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. /me depois de sair (esperado 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensagem em português', () => pm.expect(pm.response.json().message).to.include('logado'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "emailTeste",
      "value": ""
    },
    {
      "key": "senhaTeste",
      "value": "Senha12345"
    }
  ]
}