{
  "info": {
    "name": "API Condomínio - Etapa 2 (Autenticação)",
    "description": "Rode a pasta inteira na ordem (botão Run) ou as requisições uma a uma (1 a 8). Cada requisição tem testes automáticos: verde = passou, vermelho = falhou. O Postman guarda o cookie de login sozinho.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação (Better Auth)",
      "description": "Teste manual extra (conta bloqueada): no MySQL rode  UPDATE `user` SET status='bloqueado' WHERE email='SEU_EMAIL';  depois tente a requisição 5 (esperado 403). Para desbloquear: SET status='ativo'.",
      "item": [
        {
          "name": "1. Cadastrar usuário (esperado 200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-up",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"{{emailTeste}}\",\n  \"password\": \"{{senhaTeste}}\",\n  \"telefone\": \"61999990000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria a conta e já deixa você logado (o Postman guarda o cookie sozinho)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um e-mail novo a cada rodada, porque o e-mail não pode se repetir",
                  "pm.collectionVariables.set('emailTeste', 'teste' + Date.now() + '@teste.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.text();",
                  "pm.test('Não devolve senha nem token', () => {",
                  "  pm.expect(corpo).to.not.include('password');",
                  "  pm.expect(corpo).to.not.include('\"token\"');",
                  "});",
                  "pm.test('Usuário nasce com status ativo', () => pm.expect(pm.response.json().user.status).to.eql('ativo'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Cadastrar com e-mail repetido (esperado 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-up",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"{{emailTeste}}\",\n  \"password\": \"{{senhaTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 (e-mail já existe)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Cadastrar com senha curta (esperado 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
